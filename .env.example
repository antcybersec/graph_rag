# Copy to .env and fill in real values. Never commit .env.
TG_HOST=https://tg-<workspace-id>.tg-<region>.i.tgcloud.io
TG_GRAPHNAME=test
# Savanna database secret (GraphStudio > Admin > "CREATE SECRET", or the Connect panel's secret).
# This is exchanged at runtime for a short-lived JWT via POST /gsql/v1/tokens -- never used directly as apiToken.
TG_SECRET=

GOOGLE_API_KEY=

# See src/common/llm.py / .env comments: verify these model IDs actually
# respond on your key AND survive more than ~20 calls before a big run --
# some Gemini aliases hang indefinitely rather than erroring, and several
# "newer"/preview models (even non-"preview"-named ones) turned out to have
# tiny free-tier DAILY quotas that look like transient rate limits at first
# but never recover. gemini-3.1-flash-lite is the one proven reliable at
# real scale (2,863+ calls) on the key this project was built against.
GEN_MODEL=gemini-3.1-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite-preview
EXTRACTION_MODEL=gemini-3.1-flash-lite

# EMBED_PROVIDER: "gemini" (API, quota-capped) or "local" (on-device BGE via
# sentence-transformers, no quota -- recommended, see src/common/llm.py).
EMBED_PROVIDER=local
# gemini: gemini-embedding-001 + EMBED_DIM=768 (must match TigerGraph schema)
# local:  BAAI/bge-base-en-v1.5 is 768-dim natively (no schema change needed)
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
