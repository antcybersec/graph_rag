# Copy to .env and fill in. Nothing here has a default that reaches a paid
# service; every value below is either local or free-tier.

# --- the model that answers --------------------------------------------------
# GEN_PROVIDER: gemini | local | openrouter | groq
GEN_PROVIDER=gemini
GEN_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=

# A different model grades the public answers, so the system cannot score
# itself up by preferring its own phrasing. Scoring only; never used to answer.
JUDGE_MODEL=gemini-3.1-flash-lite-preview

# One-time claim extraction over the 39 LA 2028 source records, cached to
# data/results/r2_claims_cache.json. Not called while answering.
EXTRACTION_MODEL=gemini-3.1-flash-lite

# --- embeddings --------------------------------------------------------------
# Local by default: on-device BGE, no quota, no key, and the 768 dimensions
# match the vector attribute in the schema. Changing the model means
# rebuilding every chunk vector -- they are not comparable across models.
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768

# --- TigerGraph --------------------------------------------------------------
# TG_MODE: local (Community Edition in Docker, what build.sh starts) or
# savanna (a hosted workspace; auth differs, see src/r2/conn.py).
TG_MODE=local
TG_HOST=http://localhost
TG_GRAPHNAME=r2
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
# Savanna only: a database secret, exchanged for a JWT at run time.
TG_SECRET=

# --- cost reporting ----------------------------------------------------------
# USD per million tokens for GEN_MODEL, used for cost_usd_total in
# metrics.json. Set these to the rate you are actually billed so the figure
# can be audited rather than taken on trust.
INPUT_USD_PER_MTOK=0.10
OUTPUT_USD_PER_MTOK=0.40

# Harmless but noisy without it once a tokenizer has been forked.
TOKENIZERS_PARALLELISM=false

# --- optional: alternate providers, and Round 1 only -------------------------
# Only needed if you switch GEN_PROVIDER away from gemini. Both are free-tier
# and both have hard daily caps that look like transient rate limits but do not
# recover -- see the comments in src/common/llm.py before relying on either.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Round 1's Jev planner pipeline only (src/pipelines/jev_planner). The Round 2
# system never calls it.
TYPESAFE_API_KEY=

# A stalled provider call should fail and retry quickly rather than hold a
# question for minutes (one 90s stall plus backoff cost a single answer 296s).
# Normal calls here take 2-8 seconds.
GEMINI_REQUEST_TIMEOUT_MS=45000

# Pacing between generation calls, to stay under a free-tier per-minute cap.
# This sleep happens inside the call, so it is counted in the latency figures
# in metrics.json: roughly LLM_MIN_INTERVAL_SEC x (llm_calls - 1) per question
# is rate-limit waiting rather than work. Raise it if 429s appear; set it to 0
# on a paid key.
LLM_MIN_INTERVAL_SEC=4.5
